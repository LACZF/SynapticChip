0031A233    // [0x00000240] MULHSU x4, x1, x3     // x4 = high bits of 10 * (-7) (signed-unsigned)
0021B2B3    // [0x00000244] MULHU x5, x2, x1      // x5 = high bits of 150 * 10 (unsigned)

// Check multiplication results
09600093    // [0x00000248] ADDI x1, x0, 150      // x1 = expected MUL result
00200113    // [0x0000024C] ADDI x2, x2, 0        // x2 = actual result
00600193    // [0x00000250] ADDI x3, x0, 6        // x3 = test number
00000013    // [0x00000254] NOP                    // Alignment

