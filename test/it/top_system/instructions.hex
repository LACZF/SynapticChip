// Sample RISC-V instruction file (hexadecimal format)
// Contains basic arithmetic, logical, memory access and control flow instructions

// Set initial register values
001000b3    // ADDI x1, x0, 1       // x1 = 1
00200113    // ADDI x2, x0, 2       // x2 = 2
00300193    // ADDI x3, x0, 3       // x3 = 3
00400213    // ADDI x4, x0, 4       // x4 = 4
00500293    // ADDI x5, x0, 5       // x5 = 5
00208133    // ADD x2, x1, x2       // x2 = x1 + x2 = 3
403101b3    // SUB x3, x2, x3       // x3 = x2 - x3 = 0
00418233    // MUL x4, x3, x4       // x4 = x3 * x4 = 0
005202b3    // AND x5, x4, x5       // x5 = x4 & x5 = 0
00528333    // OR x6, x5, x5        // x6 = x5 | x5 = 0
005303b3    // XOR x7, x6, x5       // x7 = x6 ^ x5 = 0
00138433    // SLT x8, x7, x1       // x8 = (x7 < x1) ? 1 : 0 = 1
002404b3    // SLTU x9, x8, x2      // x9 = (x8 < x2) ? 1 : 0 = 1
00348533    // SLTI x10, x9, 3      // x10 = (x9 < 3) ? 1 : 0 = 1
001505b3    // SLLI x11, x10, 1     // x11 = x10 << 1 = 2
00158633    // SRLI x12, x11, 1     // x12 = x11 >> 1 = 1 (logical right shift)
401606b3    // SRAI x13, x12, 1     // x13 = x12 >> 1 = 0 (arithmetic right shift)
00168733    // ADDI x14, x13, 1     // x14 = x13 + 1 = 1
002707b3    // ADDI x15, x14, 2     // x15 = x14 + 2 = 3
00378833    // ADDI x16, x15, 3     // x16 = x15 + 3 = 6
004808b3    // ADDI x17, x16, 4     // x17 = x16 + 4 = 10
00588933    // ADDI x18, x17, 5     // x18 = x17 + 5 = 15
006909b3    // ADDI x19, x18, 6     // x19 = x18 + 6 = 21
00798a33    // ADDI x20, x19, 7     // x20 = x19 + 7 = 28
008a0ab3    // ADDI x21, x20, 8     // x21 = x20 + 8 = 36
009a8b33    // ADDI x22, x21, 9     // x22 = x21 + 9 = 45
00ab0bb3    // ADDI x23, x22, 10    // x23 = x22 + 10 = 55
00bb8c33    // ADDI x24, x23, 11    // x24 = x23 + 11 = 66
00cc0cb3    // ADDI x25, x24, 12    // x25 = x24 + 12 = 78
00cc8d33    // ADDI x26, x25, 13    // x26 = x25 + 13 = 91
00dd0db3    // ADDI x27, x26, 14    // x27 = x26 + 14 = 105
00dd8e33    // ADDI x28, x27, 15    // x28 = x27 + 15 = 120
00ee0eb3    // ADDI x29, x28, 16    // x29 = x28 + 16 = 136
00ee8f33    // ADDI x30, x29, 17    // x30 = x29 + 17 = 153
00ff0fb3    // ADDI x31, x30, 18    // x31 = x30 + 18 = 171
00000073    // ECALL                // system call instruction

// ===== GPIO Test Instructions =====
00400313    // ADDI x6, x0, 0x04    // x6 = 4 (REG_DIR address offset)
00300393    // ADDI x7, x0, 0x03    // x7 = 3 (pins to set as output)
F0000037    // LUI x24, 0xF0000     // x24 = 0xF0000000 (upper 32 bits of MMIO_BASE_ADDR)
000038B7    // LUI x25, 0x3         // x25 = 0x3000 (lower 32 bits of GPIO0_BASE)
00088893    // ADDI x25, x25, 0     // x25 = 0x3000
00180937    // LUI x26, 0x1         // x26 = 0x10000000
000009B7    // LUI x27, 0x0         // x27 = 0x0
00090993    // ADDI x26, x26, 0     // x26 = 0x10000000
00098A13    // ADDI x27, x27, 0     // x27 = 0x0
00000A97    // LUI x28, 0x0         // x28 = 0x0
000A0A93    // ADDI x28, x28, 0     // x28 = 0x0
000A8B13    // ADDI x29, x29, 0     // x29 = 0x0
000B0B93    // ADDI x30, x30, 0     // x30 = 0x0
000B8C13    // ADDI x31, x31, 0     // x31 = 0x0
00088933    // ADD x18, x24, x25    // x18 = GPIO0_BASE (F0000000 + 0x3000)
000909B3    // ADD x19, x26, x27    // x19 = 0x10000000
00098A33    // ADD x20, x28, x29    // x20 = 0x0
000A0AB3    // ADD x21, x30, x31    // x21 = 0x0
00068913    // ADDI x18, x18, x6    // x18 = GPIO0_BASE + REG_DIR
000788B3    // SW x7, 0(x18)        // Write to GPIO direction register, set pins 0 and 1 as output
00000313    // ADDI x6, x0, 0x00    // x6 = 0 (REG_DATA address offset)
00088913    // ADDI x18, x18, -x6   // x18 = GPIO0_BASE + REG_DATA
000188B3    // SW x1, 0(x18)        // Write to GPIO data register, set pin 0 to high
00000013    // NOP                  // Short delay
000008B3    // SW x0, 0(x18)        // Write to GPIO data register, set pin 0 to low
00000013    // NOP                  // short delay

// ===== UART Test Instructions =====
00000313    // ADDI x6, x0, 0x00    // x6 = 0 (REG_THR/REG_RBR address offset)
00000393    // ADDI x7, x0, 0x04    // x7 = 4 (REG_IER address offset)
00000413    // ADDI x8, x0, 0x0C    // x8 = 12 (REG_LCR address offset)
00000493    // ADDI x9, x0, 0x55    // x9 = 0x55 (test data 'U')
00000513    // ADDI x10, x0, 0x80   // x10 = 0x80 (LCR[7] = 1, access divisor register)
00000593    // ADDI x11, x0, 0x01   // x11 = 1 (baud rate divisor low byte)
00000613    // ADDI x12, x0, 0x00   // x12 = 0 (baud rate divisor high byte)
00000693    // ADDI x13, x0, 0x03   // x13 = 3 (8 data bits, 1 stop bit, no parity)
F0000037    // LUI x24, 0xF0000     // x24 = 0xF0000000 (upper 32 bits of MMIO_BASE_ADDR)
000018B7    // LUI x25, 0x1         // x25 = 0x1000 (lower 32 bits of UART0_BASE)
00088893    // ADDI x25, x25, 0     // x25 = 0x1000
00180937    // LUI x26, 0x1         // x26 = 0x10000000
000009B7    // LUI x27, 0x0         // x27 = 0x0
00090993    // ADDI x26, x26, 0     // x26 = 0x10000000
00098A13    // ADDI x27, x27, 0     // x27 = 0x0
00000A97    // LUI x28, 0x0         // x28 = 0x0
000A0A93    // ADDI x28, x28, 0     // x28 = 0x0
000A8B13    // ADDI x29, x29, 0     // x29 = 0x0
000B0B93    // ADDI x30, x30, 0     // x30 = 0x0
000B8C13    // ADDI x31, x31, 0     // x31 = 0x0
00088933    // ADD x18, x24, x25    // x18 = UART0_BASE (F0000000 + 0x1000)
000909B3    // ADD x19, x26, x27    // x19 = 0x10000000
00098A33    // ADD x20, x28, x29    // x20 = 0x0
000A0AB3    // ADD x21, x30, x31    // x21 = 0x0
00088913    // ADDI x18, x18, x8    // x18 = UART0_BASE + REG_LCR
000A88B3    // SW x10, 0(x18)       // Set LCR[7] = 1, access divisor register
00088913    // ADDI x18, x18, -x8   // x18 = UART0_BASE + REG_DLL
000B88B3    // SW x11, 0(x18)       // Set divisor register low byte
00078913    // ADDI x18, x18, x7    // x18 = UART0_BASE + REG_DLM
000C88B3    // SW x12, 0(x18)       // Set divisor register high byte
00088913    // ADDI x18, x18, -x7   // x18 = UART0_BASE + REG_LCR
000D88B3    // SW x13, 0(x18)       // Set line control register: 8 data bits, 1 stop bit, no parity
00068913    // ADDI x18, x18, -x8   // x18 = UART0_BASE + REG_THR
000988B3    // SW x9, 0(x18)        // Send data 'U'

// ===== Keep some NOP instructions for test stability =====
00000013    // NOP                  // no-operation instruction
00000013    // NOP                  // no-operation instruction
00000013    // NOP                  // no-operation instruction
00000013    // NOP                  // no-operation instruction
00000013    // NOP                  // no-operation instruction