// 示例RISC-V指令文件（十六进制格式）
// 包含基本的算术、逻辑、内存访问和控制流指令

// 设置寄存器初始值
001000b3  // ADDI x1, x0, 1      // x1 = 1
00200113  // ADDI x2, x0, 2      // x2 = 2
00300193  // ADDI x3, x0, 3      // x3 = 3
00400213  // ADDI x4, x0, 4      // x4 = 4
00500293  // ADDI x5, x0, 5      // x5 = 5

// 算术指令
00208133  // ADD x2, x1, x2      // x2 = x1 + x2 = 3
403101b3  // SUB x3, x2, x3      // x3 = x2 - x3 = 0
00418233  // MUL x4, x3, x4      // x4 = x3 * x4 = 0
005202b3  // ADD x5, x4, x5      // x5 = x4 + x5 = 5

// 逻辑指令
0020a1b3  // AND x3, x1, x2      // x3 = x1 & x2 = 1 & 3 = 1
0030c233  // OR  x4, x2, x3      // x4 = x2 | x3 = 3 | 1 = 3
0040e293  // XOR x5, x3, x4      // x5 = x3 ^ x4 = 1 ^ 3 = 2

// 移位指令
00311313  // SLLI x6, x2, 3      // x6 = x2 << 3 = 3 << 3 = 24
00219393  // SRLI x7, x6, 1      // x7 = x6 >> 1 = 24 >> 1 = 12
40321413  // SRAI x8, x7, 2      // x8 = x7 >>> 2 = 12 >>> 2 = 3

// 比较指令
0020e1b3  // SLT x3, x1, x2      // x3 = (x1 < x2) ? 1 : 0 = 1
00114233  // SLTU x4, x2, x1     // x4 = (x2 < x1) ? 1 : 0 = 0
00511293  // SLTI x5, x2, 5      // x5 = (x2 < 5) ? 1 : 0 = 1

// 内存访问指令（注意：在实际系统中，需要确保内存可访问）
001003b3  // ADDI x7, x0, 1      // x7 = 1
00800433  // ADDI x8, x0, 8      // x8 = 8
00702423  // SW x7, 0(x8)        // [x8+0] = x7 = 1
00402083  // LW x1, 0(x8)        // x1 = [x8+0] = 1

// 分支和跳转指令
001000e3  // BEQ x1, x1, 4       // 如果x1 == x1，跳转到PC+16（下下条指令）
00000013  // NOP                 // 这条指令不会执行
00a00533  // ADDI x10, x0, 10     // x10 = 10
0000006f  // JAL x0, 0           // 跳转到当前PC（无限循环）