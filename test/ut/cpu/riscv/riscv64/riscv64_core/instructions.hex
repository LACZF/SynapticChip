00601793  // ADDI x0, x0, 6      # Should not execute
00701813  // ADDI x0, x0, 7      # Should not execute
00801893  // ADDI x0, x0, 8      # Should not execute
00901913  // ADDI x0, x0, 9      # Should not execute
00a01993  // ADDI x19, x0, 10    # Target of JAL
00001a13  // ADDI x20, x0, 0     # Set x20 to 0
00c0026f  // JAL x0, 12          # Jump to 0x80000154
00101a93  // ADDI x0, x0, 1      # Should not execute
00201b13  // ADDI x0, x0, 2      # Should not execute
00301b93  // ADDI x0, x0, 3      # Should not execute
00401c13  // ADDI x0, x0, 4      # Should not execute
00501c93  // ADDI x25, x0, 5     # Target of JAL x0
00001d13  // ADDI x26, x0, 0     # Set x26 to 0
00000093  // ADDI x1, x0, 0      # Reset x1 to 0
00100093  // ADDI x1, x0, 1      # Set x1 to 1
008000e7  // JALR x2, x1, 8      # Jump to 0x80000170, x2 = 0x8000015c
00101d93  // ADDI x0, x0, 1      # Should not execute
00201e13  // ADDI x0, x0, 2      # Should not execute
00301e93  // ADDI x0, x0, 3      # Should not execute
00401f13  // ADDI x0, x0, 4      # Should not execute
00501f93  // ADDI x31, x0, 5     # Target of JALR

// Test Case 7: Memory Access Instructions (LB, LH, LW, LBU, LHU, LWU, LD, SB, SH, SW, SD)
00000083  // LD x1, 0(x0)        # Load x1 from memory[0] (should be 0)
064000b3  // ADDI x1, x0, 100    # x1 = 100
00200113  // ADDI x2, x0, 2      # x2 = 2 (memory offset)
00112023  // SD x1, 0(x2)        # Store x1 to memory[2]
00012083  // LD x1, 0(x2)        # Load x1 from memory[2] (should be 100)
00100093  // ADDI x1, x0, 1      # x1 = 1
00200113  // ADDI x2, x0, 4      # x2 = 4 (memory offset)
00110023  // SW x1, 0(x2)        # Store x1 to memory[4]
