// Comprehensive RISC-V64 Instruction Test Program
// This test program covers all major instruction classes and edge cases
// The program is designed to run as a single continuous execution flow

// Test program starts at 0x80000000

// Test Case 1: Basic Arithmetic Instructions (ADD, ADDI, SUB, SUBI)
000000b3  // ADD x1, x0, x0     # x1 = 0
00a00113  // ADDI x2, x0, 10     # x2 = 10
002081b3  // ADD x3, x1, x2      # x3 = 10
00508293  // ADDI x5, x3, 5      # x5 = 15
00210433  // SUB x8, x4, x2      # x8 = x4 - 10 (but x4 is 0, so x8 = -10)
00540413  // ADDI x8, x8, 5      # x8 = -5

// Test Case 2: Immediate Arithmetic Instructions (SLLI, SRLI, SRAI, SLTI, SLTIU)
001000b3  // ADDI x1, x0, 1      # x1 = 1
00409113  // SLLI x2, x1, 4      # x2 = 16
0020d193  // SRLI x3, x2, 2      # x3 = 4
FF800213  // ADDI x4, x0, -8     # x4 = -8
4020f293  // SRAI x5, x4, 2      # x5 = -2
00940313  // SLTI x6, x4, 9      # x6 = 1 (since -8 < 9)
FF642393  // SLTIU x7, x4, -10   # x7 = 0 (unsigned comparison)

// Test Case 3: Logic Instructions (AND, OR, XOR, ANDI, ORI, XORI)
AAA000b3  // ADDI x1, x0, 0xAAAA # x1 = 0xAAAA
55500113  // ADDI x2, x0, 0x5555 # x2 = 0x5555
0020a1b3  // AND x3, x1, x2      # x3 = 0x0000
0020c233  // OR x4, x1, x2       # x4 = 0xFFFF
0020e293  // XOR x5, x1, x2      # x5 = 0xFFFF
0FF0A093  // ANDI x1, x0, 0xFF   # x1 = 0xFF
1F00C113  // ORI x2, x0, 0x1F0   # x2 = 0x1F0
3E00E193  // XORI x3, x0, 0x3E0  # x3 = 0x3E0

// Test Case 4: Compare Instructions (SLT, SLTU)
005000b3  // ADDI x1, x0, 5      # x1 = 5
00a00113  // ADDI x2, x0, 10     # x2 = 10
0020e1b3  // SLT x3, x1, x2      # x3 = 1 (5 < 10)
00114233  // SLTU x4, x2, x1     # x4 = 0 (10 not < 5)
00a40293  // SLTI x5, x4, 10     # x5 = 1 (0 < 10)
FF642313  // SLTIU x6, x4, -10   # x6 = 0 (unsigned comparison)

// Test Case 5: Branch Instructions (BEQ, BNE, BLT, BGE, BLTU, BGEU)
005000b3  // ADDI x1, x0, 5      # x1 = 5
00500113  // ADDI x2, x0, 5      # x2 = 5
00a00193  // ADDI x3, x0, 10     # x3 = 10
00500213  // ADDI x4, x0, 5      # x4 = 5
00000293  // ADDI x5, x0, 0      # x5 = 0
00208463  // BEQ x1, x2, 8       # Branch to 0x80000070 (since x1 == x2)
00100513  // ADDI x10, x0, 1     # Should not execute
00200593  // ADDI x11, x0, 2     # Should not execute
00300613  // ADDI x12, x0, 3     # Should not execute
00400693  // ADDI x13, x0, 4     # Should not execute
00500713  // ADDI x14, x0, 5     # Target of BEQ
00314863  // BNE x1, x3, 8       # Branch to 0x80000090 (since x1 != x3)
00100893  // ADDI x17, x0, 1     # Should not execute
00200913  // ADDI x18, x0, 2     # Should not execute
00300993  // ADDI x19, x0, 3     # Should not execute
00400a13  // ADDI x20, x0, 4     # Should not execute
00500a93  // ADDI x21, x0, 5     # Target of BNE
0020c8e3  // BLT x1, x3, 8       # Branch to 0x800000B0 (since x1 < x3)
00100b13  // ADDI x22, x0, 1     # Should not execute
00200b93  // ADDI x23, x0, 2     # Should not execute
00300c13  // ADDI x24, x0, 3     # Should not execute
00400c93  // ADDI x25, x0, 4     # Should not execute
00500d13  // ADDI x26, x0, 5     # Target of BLT
003188e3  // BGE x3, x1, 8       # Branch to 0x800000D0 (since x3 >= x1)
00100d93  // ADDI x27, x0, 1     # Should not execute
00200e13  // ADDI x28, x0, 2     # Should not execute
00300e93  // ADDI x29, x0, 3     # Should not execute
00400f13  // ADDI x30, x0, 4     # Should not execute
00500f93  // ADDI x31, x0, 5     # Target of BGE
00212963  // BLTU x1, x3, 8      # Branch to 0x800000F0 (unsigned comparison)
00101013  // ADDI x0, x0, 1      # Should not execute
00201093  // ADDI x0, x0, 2      # Should not execute
00301113  // ADDI x0, x0, 3      # Should not execute
00401193  // ADDI x0, x0, 4      # Should not execute
00501213  // ADDI x4, x0, 5      # Target of BLTU
00316963  // BGEU x3, x1, 8      # Branch to 0x80000110 (unsigned comparison)
00101293  // ADDI x0, x0, 1      # Should not execute
00201313  // ADDI x0, x0, 2      # Should not execute
00301393  // ADDI x0, x0, 3      # Should not execute
00401413  // ADDI x0, x0, 4      # Should not execute
00501493  // ADDI x9, x0, 5      # Target of BGEU

