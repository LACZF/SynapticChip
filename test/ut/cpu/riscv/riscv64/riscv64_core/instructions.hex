// Comprehensive RISC-V64 Instruction Test Program
// This test program covers all major instruction classes and edge cases
// The program is designed to run as a single continuous execution flow

// Test program starts at 0x80000000

// Test Case 1: Basic Arithmetic Instructions (ADD, ADDI, SUB, SUBI)
000000b3  // [0x80000000] ADD x1, x0, x0     # x1 = 0
00a00113  // [0x80000004] ADDI x2, x0, 10     # x2 = 10
002081b3  // [0x80000008] ADD x3, x1, x2      # x3 = 10
00508293  // [0x8000000C] ADDI x5, x3, 5      # x5 = 15
40220433  // [0x80000010] SUB x8, x4, x2      # x8 = x4 - 10 (but x4 is 0, so x8 = -10)
00540413  // [0x80000014] ADDI x8, x8, 5      # x8 = -5

// Test Case 2: Immediate Arithmetic Instructions (SLLI, SRLI, SRAI, SLTI, SLTIU)
001000b3  // [0x80000018] ADDI x1, x0, 1      # x1 = 1
00409113  // [0x8000001C] SLLI x2, x1, 4      # x2 = 16
0020d193  // [0x80000020] SRLI x3, x2, 2      # x3 = 4
FF800213  // [0x80000024] ADDI x4, x0, -8     # x4 = -8
4020f293  // [0x80000028] SRAI x5, x4, 2      # x5 = -2
00940313  // [0x8000002C] SLTI x6, x4, 9      # x6 = 1 (since -8 < 9)
FF642393  // [0x80000030] SLTIU x7, x4, -10   # x7 = 0 (unsigned comparison)

// Test Case 3: Logic Instructions (AND, OR, XOR, ANDI, ORI, XORI)
AAA000b3  // [0x80000034] ADDI x1, x0, 0xAAAA # x1 = 0xAAAA
55500113  // [0x80000038] ADDI x2, x0, 0x5555 # x2 = 0x5555
0020a1b3  // [0x8000003C] AND x3, x1, x2      # x3 = 0x0000
0020c233  // [0x80000040] OR x4, x1, x2       # x4 = 0xFFFF
0020e293  // [0x80000044] XOR x5, x1, x2      # x5 = 0xFFFF
0FF0A093  // [0x80000048] ANDI x1, x0, 0xFF   # x1 = 0xFF
1F00C113  // [0x8000004C] ORI x2, x0, 0x1F0   # x2 = 0x1F0
3E00E193  // [0x80000050] XORI x3, x0, 0x3E0  # x3 = 0x3E0

// Test Case 4: Compare Instructions (SLT, SLTU)
005000b3  // [0x80000054] ADDI x1, x0, 5      # x1 = 5
00a00113  // [0x80000058] ADDI x2, x0, 10     # x2 = 10
0020e1b3  // [0x8000005c] SLT x3, x1, x2      # x3 = 1 (5 < 10)
00114233  // [0x80000060] SLTU x4, x2, x1     # x4 = 0 (10 not < 5)
00a40293  // [0x80000064] SLTI x5, x4, 10     # x5 = 1 (0 < 10)
FF642313  // [0x80000068] SLTIU x6, x4, -10   # x6 = 0 (unsigned comparison)

// Test Case 5: Branch Instructions (BEQ, BNE, BLT, BGE, BLTU, BGEU)
