00200093  // ADDI x1, x0, 2      # x1 = 2
00300113  // ADDI x2, x0, 6      # x2 = 6 (memory offset)
0010e023  // SH x1, 0(x2)        # Store x1 to memory[6]
0000e083  // LH x1, 0(x2)        # Load x1 from memory[6] (should be 2)
00300093  // ADDI x1, x0, 3      # x1 = 3
00400113  // ADDI x2, x0, 8      # x2 = 8 (memory offset)
0010c023  // SB x1, 0(x2)        # Store x1 to memory[8]
0000c083  // LB x1, 0(x2)        # Load x1 from memory[8] (should be 3)
FFD00093  // ADDI x1, x0, -3     # x1 = -3 (0xFFFFFFFD)
00500113  // ADDI x2, x0, 10     # x2 = 10 (memory offset)
0010c023  // SB x1, 0(x2)        # Store x1 to memory[10]
0000e083  // LH x1, 0(x2)        # Load x1 from memory[10] (sign-extended -3)
0000d083  // LBU x1, 0(x2)       # Load x1 from memory[10] (unsigned 253)
0000f083  // LHU x1, 0(x2)       # Load x1 from memory[10] (unsigned 65533)

