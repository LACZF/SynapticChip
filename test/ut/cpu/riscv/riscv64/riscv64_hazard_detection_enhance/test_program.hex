fffa0a13  // [0x80000048] addi x20, x20, -1  # x20 = 1
fffa0a13  // [0x8000004c] addi x20, x20, -1  # x20 = 0
00100a13  // [0x80000050] addi x20, x0, 1    # x20 = 1

