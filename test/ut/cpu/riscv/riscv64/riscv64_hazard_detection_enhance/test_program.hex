00200413  // [0x80000010] addi x8, x0, 2     # x8 = 2
40340433  // [0x80000014] sub x8, x8, x3     # x8 = 2-0 = 2 (will be modified)
00300413  // [0x80000018] addi x8, x0, 3     # x8 = 3
40440433  // [0x8000001c] sub x8, x8, x4     # x8 = 3-0 = 3 (will be modified)
40440433  // [0x80000020] sub x8, x8, x4     # x8 = 3-0 = 3
40440433  // [0x80000024] sub x8, x8, x4     # x8 = 3-0 = 3
